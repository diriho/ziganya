# Copy to .env.local (git-ignored) and fill in from Supabase → Project Settings → API.
# Both values are public "anon" credentials; row-level security protects the data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_API_KEY=your-anon-public-key

# Optional: used only by `npm run db:types` to regenerate sdk/db/database.types.ts
SUPABASE_PROJECT_ID=your-project-ref

# Receipt reader: "auto" (cloud when deployed, otherwise on-device OCR), "device" (free, offline,
# nothing leaves the browser) or "cloud" (Claude via the extract-receipt Edge Function).
VITE_RECEIPT_ENGINE=auto
